# ============================================================
# Jovin AI - mipangilio (nakili faili hili kuwa ".env")
# USIWEKE ".env" kwenye GitHub au kumpa mtu mwingine.
# ============================================================

# --- Lazima: ufunguo wa Groq (pata kwenye https://console.groq.com) ---
GROQ_API_KEY=

# --- Seva ---
PORT=3000
# 127.0.0.1 = simu yako tu (salama). 0.0.0.0 = vifaa vyote vya Wi-Fi yako.
HOST=127.0.0.1

# --- Modeli ya Groq (orodha: https://console.groq.com/docs/models) ---
GROQ_MODEL=llama-3.3-70b-versatile
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.7

# --- Mipaka ---
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_MESSAGES=20
REQUEST_TIMEOUT_MS=30000
# Maombi ya juu kwa dakika kwa kila IP
RATE_LIMIT_PER_MIN=20

# --- Hiari: msimbo wa ufikiaji (inapendekezwa ukiweka HOST=0.0.0.0) ---
# Ukiweka, mtumiaji ataulizwa msimbo kabla ya kutumia AI.
ACCESS_CODE=

# --- Hiari: kama uko nyuma ya reverse proxy (Nginx/Cloudflare) ---
TRUST_PROXY=false

# --- Hiari: uzalishaji wa picha (huduma ya nje, inaweza kuwa na gharama) ---
# Inatarajia API inayofuata muundo wa OpenAI "images/generations".
# Acha tupu ili kuzima. Haijajaribiwa na huduma yoyote maalum.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
